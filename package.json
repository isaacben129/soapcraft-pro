    "@radix-ui/react-select": "2.1.0",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-toast": "1.2.0",
    "@tailwindcss/postcss": "4.1.0",
    "@tailwindcss/vite": "4.1.0",
    "ai": "^7.0.48",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "^0.31.10",
