    {
      "type": "text",
      "id": "states_list",
      "x": 55,
      "y": 540,
      "width": 650,
      "height": 150,
      "text": "App: Loading → Ready → Error → Offline → Syncing\nNav: Home → Recipes → Recipe Edit → Batches → Batch Log → Cure → Costing → Library → Settings\nAuth: Logged Out → Logged In → Session Expired → Upgrading\nSub: Free → Pro Trial → Pro Active → Pro Expired → Payment Pending → Payment Failed\nData: Empty → Loading → Loaded → Error → Stale → Syncing → Saved → Saving → Save Error\nForm: Pristine → Dirty → Valid → Invalid → Submitting → Submitted → Submit Error\nCalc: Idle → Calculating → Complete → Error → Stale\nNotify: None → Info → Success → Warning → Error → Dismissed",
      "fontSize": 10,
      "fontFamily": 1,
      "strokeColor": "#1e1e1e",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "App: Loading → Ready → Error → Offline → Syncing\nNav: Home → Recipes → Recipe Edit → Batches → Batch Log → Cure → Costing → Library → Settings\nAuth: Logged Out → Logged In → Session Expired → Upgrading\nSub: Free → Pro Trial → Pro Active → Pro Expired → Payment Pending → Payment Failed\nData: Empty → Loading → Loaded → Error → Stale → Syncing → Saved → Saving → Save Error\nForm: Pristine → Dirty → Valid → Invalid → Submitting → Submitted → Submit Error\nCalc: Idle → Calculating → Complete → Error → Stale\nNotify: None → Info → Success → Warning → Error → Dismissed",
      "autoResize": true
    }
